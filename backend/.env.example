# ── Variables d'environnement requises (backend) ─────────────────────────────
# Copier ce fichier en .env et remplir les valeurs

# Base de données PostgreSQL
DB_DIALECT=postgres
DB_HOST=
DB_PORT=5432
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_SSL=true

# Frontend
FRONTEND_URL=https://scolarite.letoitdesanges.com

# ── WhatsApp / n8n ───────────────────────────────────────────────────────────
# Webhook n8n pour l'envoi de messages WhatsApp sortants
N8N_WHATSAPP_WEBHOOK=
# Timeout en ms pour les appels n8n (défaut: 30000)
N8N_WHATSAPP_TIMEOUT=30000
# Code pays par défaut pour la normalisation des numéros
WHATSAPP_DEFAULT_CC=221

# Token système Meta (pour le script de création de templates uniquement)
# JAMAIS commité — généré dans developers.facebook.com
WA_TOKEN=

# ── Botpress (obsolète — remplacé par n8n) ───────────────────────────────────
# BOTPRESS_WEBHOOK_URL=
# BOTPRESS_BOT_ID=
# BOTPRESS_TOKEN=
